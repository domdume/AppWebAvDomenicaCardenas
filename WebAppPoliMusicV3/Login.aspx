<%@ Page Language="C#" ResponseEncoding="utf-8" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="WebAppPoliMusicV3.Login" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Iniciar sesión · PoliMusic</title><link rel="stylesheet" href="Content/song.css" /></head><body class="auth-page"><main class="auth-card"><a class="brand" href="Default"><span class="brand-icon">≋</span> PoliMusic</a><span class="eyebrow">TU MÚSICA EMPIEZA AQUÍ</span><h1>Vuelve a tu ritmo.</h1><p>Inicia sesión para entrar a tu biblioteca.</p><form id="formLogin" runat="server"><div class="fields"><div><asp:Label runat="server" AssociatedControlID="txtLogin" Text="Nombre de usuario" /><asp:TextBox ID="txtLogin" runat="server" autocomplete="username" /></div><div><asp:Label runat="server" AssociatedControlID="txtPassword" Text="Contraseña" /><asp:TextBox ID="txtPassword" runat="server" TextMode="Password" autocomplete="current-password" /></div></div><asp:Label ID="lblMessage" runat="server" CssClass="auth-error" role="alert" /><asp:Button ID="btnLogin" runat="server" CssClass="primary" Text="Iniciar sesión" OnClick="BtnLogin_Click" /><p>¿Primera vez aquí? <asp:LinkButton ID="LinkButtonNewUser" runat="server" OnClick="LinkButtonNewUser_Click">Crear una cuenta</asp:LinkButton></p></form></main></body></html>
