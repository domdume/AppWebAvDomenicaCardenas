<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebAppPoliMusicV3.SiteMaster" %>
<!DOCTYPE html>
<html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%: Page.Title %> · PoliMusic</title><link runat="server" href="~/Content/song.css" rel="stylesheet" /></head>
<body><form id="formSite" runat="server"><asp:ScriptManager ID="ScriptManager1" runat="server" /><a class="skip" href="#library">Saltar al contenido</a>
<div class="app-shell"><aside class="sidebar"><a class="brand" runat="server" href="~/Default"><span class="brand-icon">≋</span> <span class="brand-name">PoliMusic<span class="brand-owner"> – Domenica Cardenas</span></span></a><nav aria-label="Navegación principal"><a id="navHome" runat="server" class="nav-item" href="~/Default">⌂ <span>Inicio</span></a><a id="navSongs" runat="server" class="nav-item" href="~/Song">▤ <span>Canciones</span></a></nav><div class="sidebar-note"><span class="eyebrow">HECHO PARA ESCUCHAR</span><h2>Tu música.<br />Tu momento.</h2><p>Todas tus canciones,<br />en un solo lugar.</p><a runat="server" href="~/Song#editor">+ Añadir una canción</a></div><div class="sidebar-footer">POLIMUSIC / DOMENICA CARDENAS</div></aside>
<main id="library"><header class="topbar"><span class="eyebrow">TU ESPACIO PARA LA MÚSICA</span><div class="account"><span class="avatar" aria-hidden="true">●</span><asp:Literal ID="litUser" runat="server" Mode="Encode" /><a class="logout" runat="server" href="~/Logout">Cerrar sesión ↗</a></div></header><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main></div>
<asp:ContentPlaceHolder ID="PlayerContent" runat="server" /></form><asp:ContentPlaceHolder ID="PageScripts" runat="server" /></body></html>
