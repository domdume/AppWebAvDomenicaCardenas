<%@ Page Title="Canciones" ResponseEncoding="utf-8" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Song.aspx.cs" Inherits="WebAppPoliMusicV3.Song" %>
<asp:Content ID="SongsContent" ContentPlaceHolderID="MainContent" runat="server"><section class="hero"><div class="cover" aria-hidden="true"><span>♫</span><small>POLIMUSIC</small></div><div class="hero-copy"><span class="eyebrow">TU COLECCIÓN PERSONAL</span><h1>Tu biblioteca</h1><p>El lugar donde empieza tu próximo momento favorito.</p><div class="hero-meta"><strong>PoliMusic</strong><span>•</span><asp:Literal ID="litCount" runat="server" /> canciones</div></div></section>
<section class="library-content" aria-label="Canciones">
<div class="toolbar"><label class="sr-only" for="songSearch">Buscar canciones</label><input id="songSearch" class="library-search" type="search" placeholder="Buscar en tus canciones" /><button type="button" id="playAll" class="play-all" aria-label="Reproducir biblioteca">▶</button><a class="add-song" href="#editor">+ Añadir canción</a><span class="view-label">Lista &nbsp; ☷</span></div>
<asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="message" role="status"><asp:Literal ID="litMessage" runat="server" Mode="Encode" /></asp:Panel>
<div class="table-scroll"><asp:GridView ID="gridSongs" runat="server" AutoGenerateColumns="false" GridLines="None" CssClass="song-table" DataKeyNames="ID" OnRowCommand="Songs_Command" EmptyDataText="Tu biblioteca está vacía. Añade tu primera canción abajo."><Columns>
<asp:BoundField DataField="ID" HeaderText="#" />
<asp:TemplateField HeaderText="Título"><ItemTemplate><div class="track-title"><span class="track-art" aria-hidden="true">♫</span><div><strong class="song-name"><%# Server.HtmlEncode(Eval("SongName").ToString()) %></strong><small>Audio · PoliMusic</small></div></div></ItemTemplate></asp:TemplateField>
<asp:BoundField DataField="Plays" HeaderText="Reproducciones" NullDisplayText="—" />
<asp:TemplateField HeaderText="Escuchar"><ItemTemplate><button type="button" class="track-play" data-src='<%# AudioUrl(Eval("SongPath")) %>' data-title='<%# System.Web.HttpUtility.HtmlAttributeEncode(Eval("SongName").ToString()) %>' aria-label='<%# "Reproducir " + System.Web.HttpUtility.HtmlAttributeEncode(Eval("SongName").ToString()) %>'>▶ <span>Escuchar</span></button></ItemTemplate></asp:TemplateField>
<asp:TemplateField HeaderText="Gestionar"><ItemTemplate><asp:LinkButton runat="server" Text="Editar" CssClass="row-action" CommandName="EditSong" CommandArgument='<%# Eval("ID") %>' CausesValidation="false" /><asp:LinkButton runat="server" Text="Eliminar" CssClass="row-action delete" CommandName="DeleteSong" CommandArgument='<%# Eval("ID") %>' CausesValidation="false" OnClientClick="return confirm('¿Eliminar esta canción de la biblioteca? Esta acción no se puede deshacer.');" /></ItemTemplate></asp:TemplateField>
</Columns></asp:GridView></div><p id="noResults" hidden>No encontramos canciones con ese nombre. Prueba otra búsqueda.</p>
<section id="editor" class="editor"><div><span class="eyebrow">DALE MÁS MÚSICA A TU DÍA</span><h2><asp:Literal ID="litEditor" runat="server" Text="Añadir canción" /></h2><p>Usa un archivo de audio guardado en la carpeta SongFiles.</p></div><div class="fields"><div><asp:Label runat="server" AssociatedControlID="txtName" Text="Nombre de la canción" /><asp:TextBox ID="txtName" runat="server" MaxLength="50" /></div><div class="path-field"><asp:Label runat="server" AssociatedControlID="txtPath" Text="Ruta del archivo" /><asp:TextBox ID="txtPath" runat="server" MaxLength="255" Text="~/SongFiles/" /></div><div><asp:Label runat="server" AssociatedControlID="txtPlays" Text="Reproducciones (opcional)" /><asp:TextBox ID="txtPlays" runat="server" MaxLength="10" /></div></div><div class="editor-actions"><asp:Button ID="btnSave" runat="server" Text="Guardar canción" CssClass="primary" OnClick="Save_Click" /><asp:Button ID="btnCancel" runat="server" Text="Cancelar edición" CssClass="secondary" OnClick="Cancel_Click" Visible="false" CausesValidation="false" /></div></section>
<footer class="content-footer">La música te acompaña. <span>PoliMusic</span></footer></section>
</asp:Content>
<asp:Content ID="PlayerContent" ContentPlaceHolderID="PlayerContent" runat="server"><footer class="player"><div class="now-playing"><span class="mini-cover" aria-hidden="true">♫</span><div><strong id="nowTitle">Tu próxima canción te espera</strong><small id="playerStatus" role="status">Elige una canción de tu biblioteca</small></div></div><div class="player-controls"><button type="button" id="previousTrack" aria-label="Canción anterior">◀</button><audio id="audioPlayer" controls preload="none" aria-label="Reproductor de música"></audio><button type="button" id="nextTrack" aria-label="Siguiente canción">▶</button></div><span class="player-brand">♫ &nbsp; POLIMUSIC</span></footer>
</asp:Content>
<asp:Content ID="ScriptsContent" ContentPlaceHolderID="PageScripts" runat="server"><script charset="utf-8" src="<%= ResolveUrl("~/Scripts/song.js?v=3") %>"></script></asp:Content>